#!/usr/bin/env node
// sync-upstream — merge upstream/main into this clone's main once a day at 06:00 UTC.
//
// One pass: only on main, wait out the update lock and a dirty tree, merge upstream/main
// (never rebase, reset, stash or resolve a conflict), reinstall when pnpm-lock.yaml came
// along, push origin main, and wake the user only when the merge touched server/, shared/
// or bin/ (or packages were installed) — that needs a host restart.

import { spawnSync } from 'node:child_process';
import { existsSync } from 'node:fs';

const REPO = '/home/bsylla/ultimate';
const LOCK = `${REPO}/.git/ultimate-update.lock`;
const MIN = 60_000;
const HOUR = 60 * MIN;

const log = (msg) => console.log(`${new Date().toISOString()} ${msg}`);
const fire = (msg) => console.log(`FIRE ${msg}`);

function sh(cmd, args) {
  const r = spawnSync(cmd, args, {
    cwd: REPO,
    env: { ...process.env, GIT_TERMINAL_PROMPT: '0' },
    encoding: 'utf8',
  });
  if (r.error) return { ok: false, out: '', err: String(r.error.message) };
  return { ok: r.status === 0, out: (r.stdout ?? '').trim(), err: (r.stderr ?? '').trim() };
}

const git = (...args) => sh('git', ['-C', REPO, ...args]);
const lines = (s) => s.split('\n').map((l) => l.trim()).filter(Boolean);
const short = () => git('rev-parse', '--short', 'HEAD').out;

function first(items, n = 3) {
  const head = items.slice(0, n).join(', ');
  return items.length > n ? `${head} (+${items.length - n} more)` : head;
}

let stopping = false;
process.on('SIGTERM', () => {
  stopping = true;
});
process.on('SIGINT', () => {
  stopping = true;
});

const sleep = (ms) => new Promise((res) => setTimeout(res, ms));

// Sleep in 30 s chunks so a SIGTERM ends the wait promptly; false once stopping.
async function pause(ms) {
  const until = Date.now() + ms;
  while (!stopping && Date.now() < until) await sleep(Math.min(30_000, until - Date.now()));
  return !stopping;
}

async function onePass() {
  // 1. only sync main.
  const branch = git('rev-parse', '--abbrev-ref', 'HEAD');
  if (!branch.ok) return fire(`cannot read the current branch: ${branch.err}`);
  if (branch.out !== 'main') return log(`on branch ${branch.out}, not main — skipping this pass`);

  // 2. the update extension's clone-wide lock: retry every 15 min, at most 6 times.
  for (let i = 1; existsSync(LOCK); i++) {
    if (i > 6) return log('update lock still held after 6 checks — skipping today');
    log(`update lock held (${LOCK}) — retry ${i}/6 in 15 min`);
    if (!(await pause(15 * MIN))) return;
  }

  // 3. a dirty tree: retry every 30 min for up to 8 h.
  const dirtyUntil = Date.now() + 8 * HOUR;
  let dirty = lines(git('status', '--porcelain', '--untracked-files=no').out).map((l) => l.slice(3));
  while (dirty.length) {
    if (Date.now() >= dirtyUntil) return fire(`working tree still dirty after 8h: ${first(dirty)}`);
    log(`working tree dirty — retry in 30 min: ${first(dirty)}`);
    const wait = Math.min(30 * MIN, Math.max(1_000, dirtyUntil - Date.now()));
    if (!(await pause(wait))) return;
    dirty = lines(git('status', '--porcelain', '--untracked-files=no').out).map((l) => l.slice(3));
  }

  // 4. fetch.
  const fetched = git('fetch', '--quiet', 'upstream', 'main');
  if (!fetched.ok) return fire(`fetch from upstream failed: ${fetched.err}`);

  // 5. already contains upstream/main.
  if (git('merge-base', '--is-ancestor', 'upstream/main', 'HEAD').ok) {
    return log(`up to date ${short()}`);
  }

  // 6. merge; on conflict report the files, abort, and leave main untouched.
  const before = git('rev-parse', 'HEAD').out;
  const merged = git('merge', '--no-edit', 'upstream/main');
  if (!merged.ok) {
    const conflicts = lines(git('diff', '--name-only', '--diff-filter=U').out);
    if (git('rev-parse', '-q', '--verify', 'MERGE_HEAD').ok) git('merge', '--abort');
    if (conflicts.length) {
      return fire(
        `upstream merge conflicts in: ${first(conflicts)} — nothing merged, main is at ${short()}`,
      );
    }
    return fire(`merging upstream/main failed: ${merged.err}`);
  }

  // 7. the merged range may need packages.
  const changed = lines(git('diff', '--name-only', `${before}..HEAD`).out);
  const installed = changed.includes('pnpm-lock.yaml');
  if (installed) {
    const r = sh('pnpm', ['install', '--frozen-lockfile']);
    if (!r.ok) {
      const tail = lines(r.err || r.out).slice(-3).join(' ');
      return fire(`merged ${short()} but pnpm install failed: ${tail}`);
    }
    log('installed packages from the merged lockfile');
  }

  // 8. push.
  const pushed = git('push', 'origin', 'main');
  if (!pushed.ok) return fire(`merged ${short()} locally but the push to origin failed: ${pushed.err}`);

  // 9. wake only when a restart is needed.
  const sha = short();
  const count = git('rev-list', '--count', `${before}..HEAD`).out;
  const areas = ['server/', 'shared/', 'bin/'].filter((dir) =>
    changed.some((p) => p.startsWith(dir)),
  );
  if (installed) areas.push('packages installed');
  if (areas.length) {
    return fire(`synced to ${sha} — needs a host restart: ${count} commits, touched ${areas.join(', ')}`);
  }
  log(`synced to ${sha}: ${count} commits, reload only`);
}

function msToNext6amUtc() {
  const t = new Date();
  const next = Date.UTC(t.getUTCFullYear(), t.getUTCMonth(), t.getUTCDate(), 6);
  return (next > t.getTime() ? next : next + 24 * HOUR) - t.getTime();
}

if (process.argv.includes('--once')) {
  await onePass();
} else {
  log(`sleeping until 06:00 UTC — ${REPO}`);
  while (!stopping) {
    if (!(await pause(msToNext6amUtc()))) break;
    await onePass();
  }
  log('stopped');
}
