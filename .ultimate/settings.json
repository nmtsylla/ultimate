{
  "extensions": {
    "enable": ["mission-control"],
    "disable": ["voice-live"]
  },
  "modelFamilies": {
    "families": {
      "lead": { "model": "opencode/claude-opus-5-5", "thinking": "high", "color": "orange" },
      "review": { "model": "kimi-coding/k3", "thinking": "high" },
      "fast": { "model": "opencode/deepseek-v4.1-flash" }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      { "command": "pnpm test", "timeout": 180 },
      { "command": "pnpm test:e2e", "timeout": 180 }
    ],
    "push": "origin"
  }
}
